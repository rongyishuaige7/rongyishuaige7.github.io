---
import "@fontsource-variable/geist/index.css";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/studio.css";
import "../styles/motion.css";
import { Image } from "astro:assets";
import timelineShot from "../assets/dsh/timeline-dark.png";
import overviewShot from "../assets/dsh/overview-dark.png";
import trendsShot from "../assets/dsh/trends-dark.png";
import { dshUsage, hardwareFamilies, hardwareFeatured, hardwareHeroDeck, hardwarePhotos, hardwareShortNames, laneMeta, toolGroups, toolShots, yipan } from "../data/projects";
import { manualUpdates } from "../data/build-log";
import type { Lane } from "../data/build-log";
import githubStatus from "../data/github-status.json";
import studioData from "../data/studio.json";

const timeZone = "Asia/Shanghai";
const minuteFormat = new Intl.DateTimeFormat("zh-CN", { timeZone, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false });
const dayFormat = new Intl.DateTimeFormat("zh-CN", { timeZone, year: "numeric", month: "2-digit", day: "2-digit" });
const numberFormat = new Intl.NumberFormat("zh-CN");
const formatDay = (iso: string) => dayFormat.format(new Date(iso)).replaceAll("/", ".");
const isoDay = (iso: string) => formatDay(iso).replaceAll(".", "-");
const refreshedAt = minuteFormat.format(new Date(githubStatus.generatedAt));

type CiSignal = { status: string; conclusion?: string | null; url?: string; headSha?: string; runAt?: string; scope?: string; event?: string; workflow?: string };
type ReleaseSignal = { status: string; tag?: string; url?: string; publishedAt?: string };
type ArtifactSignal = { status: string; artifacts?: Array<{ name: string; url: string; expiresAt: string; expired: boolean }> };
type RepositoryStatus = { url: string; headSha: string | null; headCommittedAt?: string | null; ci: CiSignal; release: ReleaseSignal; artifact: ArtifactSignal };
type DisplaySignal = {
  kind: "ci" | "release" | "artifact" | "commit";
  label: string;
  href: string;
  tone: "pass" | "release" | "running" | "failure" | "stale" | "neutral";
};

const repoStatus = githubStatus.repositories as unknown as Record<string, RepositoryStatus>;
const statusSourceUrl = "https://github.com/rongyishuaige7/rongyishuaige7.github.io/blob/main/scripts/fetch-github-status.mjs";

function ciSignal(signal: RepositoryStatus): DisplaySignal | null {
  const ci = signal.ci;
  const href = ci.url ?? signal.url;
  const scope = ci.scope ?? "CI";
  const joined = /^[A-Za-z0-9]/.test(scope) ? ` ${scope}` : scope;
  if (ci.status === "not_configured") return null;
  if (ci.status === "unknown") return { kind: "ci", label: `${scope}状态暂时无法确认`, href, tone: "neutral" };
  if (ci.status === "unverified") return { kind: "ci", label: `当前提交${joined}尚未核验`, href, tone: "neutral" };
  if (["queued", "in_progress", "requested", "waiting", "pending"].includes(ci.status)) return { kind: "ci", label: `当前提交正在运行${joined}`, href, tone: "running" };
  if (ci.status === "completed" && ci.conclusion === "success") {
    return { kind: "ci", label: `当前提交${joined}通过${ci.runAt ? ` · ${formatDay(ci.runAt)}` : ""}`, href, tone: "pass" };
  }
  if (ci.status === "completed") return { kind: "ci", label: `当前提交${joined} ${ci.conclusion ?? "状态未知"}`, href, tone: "failure" };
  return { kind: "ci", label: `${scope}状态暂时无法确认`, href, tone: "neutral" };
}
function releaseSignal(signal: RepositoryStatus): DisplaySignal | null {
  const release = signal.release;
  if (release.status === "available" && release.tag && release.url) return { kind: "release", label: `已发布 ${release.tag}`, href: release.url, tone: "release" };
  if (release.status === "unknown") return { kind: "release", label: "暂时无法确认发布状态", href: signal.url, tone: "neutral" };
  return null;
}

function artifactSignal(signal: RepositoryStatus): DisplaySignal | null {
  const artifact = signal.artifact;
  const first = artifact.artifacts?.find((item) => !item.expired && Number.isFinite(Date.parse(item.expiresAt)) && Date.parse(item.expiresAt) > Date.now());
  if (artifact.status === "available" && first) return { kind: "artifact", label: `固件构建产物保留至 ${formatDay(first.expiresAt)}`, href: first.url, tone: "pass" };
  if (artifact.status === "available" || artifact.status === "expired") return { kind: "artifact", label: "固件构建产物已过期", href: signal.url, tone: "stale" };
  if (artifact.status === "unknown") return { kind: "artifact", label: "暂时无法确认构建产物", href: signal.url, tone: "neutral" };
  if (artifact.status === "unavailable" || artifact.status === "none") return { kind: "artifact", label: "当前没有固件构建产物", href: signal.url, tone: "neutral" };
  return null;
}

function commitSignal(signal: RepositoryStatus): DisplaySignal | null {
  if (!signal.headCommittedAt) return null;
  return { kind: "commit", label: `最近提交 ${formatDay(signal.headCommittedAt)}`, href: `${signal.url}/commits`, tone: "neutral" };
}

function primarySignal(slug: string): DisplaySignal | null {
  const signal = repoStatus[slug];
  if (!signal) return null;
  return ciSignal(signal) ?? releaseSignal(signal) ?? artifactSignal(signal) ?? commitSignal(signal);
}

function evidenceSignals(slug: string): DisplaySignal[] {
  const signal = repoStatus[slug];
  if (!signal) return [];
  return [releaseSignal(signal), ciSignal(signal), artifactSignal(signal)].filter((item): item is DisplaySignal => item !== null);
}

// "Recent" is measured against the status snapshot, so a build is deterministic for its data.
const snapshotAt = Date.parse(githubStatus.generatedAt);
function isRecent(slug: string) {
  const committed = Date.parse(repoStatus[slug]?.headCommittedAt ?? "");
  return Number.isFinite(committed) && snapshotAt - committed <= 30 * 86_400_000;
}

type NpmSummary = { status?: string; latest?: string; publishedAt?: string; versionCount?: number; versionsLast30Days?: number; downloadsLastMonth?: number | null; url?: string };
type HardwareProject = { slug: string; name: string; repo: string; platform: string; family: string; chip: string; summary: string; evidence: { status: string; headSha?: string | null; indexedSha?: string | null; runUrl?: string | null } };
type StudioData = {
  generatedAt: string;
  sources: Record<string, { status: string }>;
  npm: Record<string, NpmSummary>;
  hardware: { status: string; indexUrl: string; statusDate?: string | null; projects: HardwareProject[] };
  updates: Array<{ date: string; lane: Lane; type: string; title: string; text: string; href: string }>;
};
const studio = studioData as unknown as StudioData;
const dshNpm = studio.npm["@rongyi7/dsh-stats"] ?? {};
const dshDownloads = typeof dshNpm.downloadsLastMonth === "number" ? dshNpm.downloadsLastMonth : null;
const dshSignal = primarySignal(dshUsage.slug);
const dshSlides = [
  { key: "overview", label: "总览", src: overviewShot, alt: "DSH Usage 项目总览界面：当日预估费用、Token、会话数与 LLM 时长，下方按项目列出 Token、缓存命中与费用" },
  { key: "timeline", label: "时间线", src: timelineShot, alt: "DSH Usage 开发时间线界面：每半小时的 Token 柱与按项目排列的会话泳道" },
  { key: "trends", label: "趋势", src: trendsShot, alt: "DSH Usage 用量趋势界面：总 Token、预估费用、活跃与连续天数、活动热力图和近 7 天每日 Token" }
];
// Tool screenshots are keyed by repository slug; a slug without a file keeps the text-only row.
const toolFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/tools/*.png", { eager: true });
const toolShot = (slug: string) => {
  const meta = toolShots[slug];
  const file = toolFiles[`../assets/tools/${slug}.png`]?.default;
  return meta && file ? { ...meta, src: file } : null;
};

const hardwareOk = studio.hardware.status === "ok" && studio.hardware.projects.length > 0;
// Photo files are keyed by repository slug; a slug without a file renders the placeholder.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/hardware/*.jpg", { eager: true });
const hardwarePhoto = (slug: string) => {
  const meta = hardwarePhotos[slug];
  const file = photoFiles[`../assets/hardware/${slug}.jpg`]?.default;
  return meta && file ? { ...meta, src: file } : null;
};
const photoDate = (date: string | null) => (date ? date.replaceAll("-", ".") : "未注明日期");
// Featured wide tiles first, then photographed projects, then projects without a public photo;
// index order is kept inside each group.
const hardwareRank = (slug: string) => (hardwareFeatured.includes(slug) ? 0 : hardwarePhoto(slug) ? 1 : 2);
const hardwareProjects = studio.hardware.projects
  .map((project, index) => ({ project, index }))
  .sort((a, b) => hardwareRank(a.project.slug) - hardwareRank(b.project.slug) || a.index - b.index)
  .map(({ project }) => project);
const heroDeck = hardwareHeroDeck.map(hardwarePhoto).filter((photo) => photo !== null);
const hardwareSignal = primarySignal("YI-Hardware-Lab");
const verifiedHardware = hardwareProjects.filter((project) => project.evidence?.status === "verified").length;
const hardwareEvidenceLabel: Record<string, string> = { verified: "当前提交构建通过", failure: "当前提交构建未通过", running: "当前提交构建中", unverified: "当前提交未核验", unknown: "构建证据暂不可确认" };
const hardwareFilters = [
  { key: "all", label: "全部", count: hardwareProjects.length },
  ...hardwareFamilies.map((family) => ({ key: family.key, label: family.label, count: hardwareProjects.filter((project) => project.family === family.key).length }))
].filter((filter) => filter.count > 0);
const familyLabel = (family: string) => hardwareFamilies.find((item) => item.key === family)?.label ?? "其他";
const hardwareEvidenceTone = (status?: string) => (status === "verified" ? "pass" : status === "failure" ? "failure" : "neutral");
const stackLine = (platform: string) => platform.split(" · ").slice(1, 4).join(" · ");

const updates = [
  ...studio.updates,
  ...manualUpdates.map((item) => ({ ...item, date: `${item.date}T00:00:00+08:00` }))
]
  .filter((item) => Number.isFinite(Date.parse(item.date)))
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))
  .slice(0, 8);
const sourceNames: Record<string, string> = { publicRepos: "公开仓库列表", npm: "npm", hardware: "Hardware Lab 索引", hardwareEvidence: "硬件构建核验", releases: "GitHub Releases" };
const degradedSources = Object.entries(studio.sources).filter(([, source]) => source.status !== "ok").map(([key]) => sourceNames[key] ?? key);
const oldestSnapshot = new Date(Math.min(Date.parse(studio.generatedAt), snapshotAt)).toISOString();
const snapshotDelayed = Date.now() - Date.parse(oldestSnapshot) >= 12 * 3_600_000;
const studioRefreshedAt = minuteFormat.format(new Date(studio.generatedAt));

const signalKindLabel: Record<DisplaySignal["kind"], string> = { release: "发布", ci: "CI", artifact: "构建产物", commit: "提交" };

const proofGroups: Array<{ lane: Lane; items: Array<{ slug: string; name: string; href: string }> }> = [
  { lane: "carry", items: [{ slug: yipan.slug, name: yipan.name, href: yipan.href }] },
  { lane: "see", items: [{ slug: dshUsage.slug, name: dshUsage.name, href: dshUsage.href }, ...toolGroups.flatMap((group) => group.tools.map((tool) => ({ slug: tool.slug, name: tool.name, href: tool.href })))] },
  { lane: "touch", items: [{ slug: "YI-Hardware-Lab", name: "Hardware Lab 索引", href: "https://github.com/rongyishuaige7/YI-Hardware-Lab" }, { slug: "ESP32_RPS_Game", name: "ESP32 RPS Game", href: "https://github.com/rongyishuaige7/ESP32_RPS_Game" }] }
];
function proofRows(item: { slug: string; name: string; href: string }) {
  const signals = evidenceSignals(item.slug);
  if (signals.length > 0) return signals.map((signal, index) => ({ ...signal, slug: item.slug, name: index === 0 ? item.name : `${item.name} · ${signalKindLabel[signal.kind]}` }));
  if (item.slug === yipan.slug) return [{ kind: "commit" as const, label: "产品事实与路线图已公开", href: item.href, tone: "neutral" as const, slug: item.slug, name: item.name }];
  const commit = repoStatus[item.slug] ? commitSignal(repoStatus[item.slug]) : null;
  return [{ ...(commit ?? { kind: "commit" as const, label: "尚未配置自动检查", href: item.href, tone: "neutral" as const }), slug: item.slug, name: item.name }];
}
const iconClass = (tone: DisplaySignal["tone"]) => (tone === "pass" || tone === "release" ? "ok" : tone === "failure" ? "failure" : "document");

const title = "Rongyi — 独立开发者 · Yi盘创始人";
const description = "Rongyi 的项目：Yi盘、DSH Usage、Agent 开发工具，以及 ESP32、STM32 和树莓派硬件原型。";
const siteUrl = "https://rongyishuaige7.github.io/";
const socialImage = `${siteUrl}og-card.png`;
const socialImageAlt = "Rongyi Studio：Yi盘，U 盘里的 AI 工作台；DSH Usage，会话、Token 与模型费用；Hardware Lab，ESP32、STM32 与树莓派硬件原型。";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Person", "@id": `${siteUrl}#person`, name: "Rongyi", url: siteUrl, sameAs: ["https://github.com/rongyishuaige7"], jobTitle: "Independent developer, founder of Yi盘" },
    { "@type": "WebSite", "@id": `${siteUrl}#website`, url: siteUrl, name: "Rongyi Studio", description, inLanguage: "zh-CN", publisher: { "@id": `${siteUrl}#person` } }
  ]
};
const lanes: Lane[] = ["carry", "see", "touch"];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090d" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content="Rongyi Studio" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Rongyi Studio" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Rongyi Studio" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={siteUrl} />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      // Settle the theme before first paint, then hide reveal targets only once scripts run.
      document.documentElement.classList.add("js");
      try {
        var saved = localStorage.getItem("rongyi-theme");
        var light = saved === "light" || (saved !== "dark" && matchMedia("(prefers-color-scheme: light)").matches);
        document.documentElement.dataset.theme = light ? "light" : "dark";
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.content = light ? "#f4f6f9" : "#07090d";
      } catch (error) { /* Storage may be blocked; the CSS media query still picks a theme. */ }
      setTimeout(function () {
        if (!document.documentElement.classList.contains("motion-ready")) document.documentElement.classList.remove("js");
      }, 4000);
    </script>
    <title>{title}</title>
  </head>
  <body>
    <canvas class="particle-field" data-particle-field aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <div class="ambient" aria-hidden="true"><i></i><i></i><i></i></div>

    <header class="site-header" data-header>
      <a class="wordmark" href="#top" title="回到首页">
        <span>R</span><b>RONGYI</b><small>/ STUDIO</small>
      </a>
      <nav aria-label="主导航" data-lane-nav>
        {lanes.map((lane) => <a href={laneMeta[lane].href} data-lane={lane}><i aria-hidden="true"></i>{laneMeta[lane].short}</a>)}
        <a href="#log"><i aria-hidden="true"></i>更新</a>
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" type="button" data-theme-toggle title="切换到浅色模式">
          <span class="visually-hidden">切换到浅色模式</span>
          <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
            <g class="icon-sun"><circle cx="12" cy="12" r="4.3" /><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6" /></g>
            <path class="icon-moon" d="M20.6 14.4A8.7 8.7 0 0 1 9.6 3.4a8.7 8.7 0 1 0 11 11Z" />
          </svg>
        </button>
        <a class="header-link" href="https://github.com/rongyishuaige7" target="_blank" rel="noreferrer">GITHUB <span>↗</span></a>
      </div>
    </header>
    <nav class="mobile-nav" aria-label="移动端章节导航" data-lane-nav>
      {lanes.map((lane) => <a href={laneMeta[lane].href} data-lane={lane}><i aria-hidden="true"></i>{laneMeta[lane].short}</a>)}
      <a href="#log"><i aria-hidden="true"></i>更新</a>
    </nav>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <h1 id="hero-title" class="hero-enter">Rongyi<span class="hero-slash" aria-hidden="true"></span></h1>
        <div class="project-map hero-enter" style="--d:.1s" role="group" aria-label="项目入口">
          <a class="project-entry entry-carry" href="#carry" data-lane="carry">
            <div class="entry-copy"><h2>Yi盘 <span aria-hidden="true">↓</span></h2><p>U 盘里的 AI 工作台</p><small>受控内测</small></div>
            <div class="entry-visual" aria-hidden="true">
              <div class="drive-body"><div class="drive-port"><i></i><i></i><i></i></div><div class="drive-face"><b class="drive-brand"><span class="brand-latin">YI</span><span class="brand-cjk">盘</span></b><div class="drive-lines"><i></i><i></i><i></i></div></div></div>
            </div>
            <span class="entry-caption">功能示意</span>
          </a>
          <a class="project-entry entry-see" href="#see" data-lane="see">
            <div class="entry-copy"><h2>DSH Usage <span aria-hidden="true">↓</span></h2><p>会话、Token 与模型费用</p></div>
            <div class="entry-shot"><Image src={trendsShot} alt="" widths={[480, 820, 1180]} sizes="(max-width: 760px) 92vw, 42vw" loading="eager" fetchpriority="high" /></div>
            <span class="entry-caption">运行截图 · 夹具数据</span>
          </a>
          <a class="project-entry entry-touch" href="#touch" data-lane="touch">
            <div class="entry-copy"><h2>Hardware Lab <span aria-hidden="true">↓</span></h2><p>{hardwareOk ? `${hardwareProjects.length} 个硬件原型` : "硬件原型"}</p></div>
            <div class="entry-visual" aria-hidden="true">
              <div class="photo-deck">
                {heroDeck.map((photo) => <Image src={photo.src} alt="" widths={[160, 320]} sizes="(max-width: 760px) 70px, 160px" loading="eager" style={photo.position ? `object-position:${photo.position}` : undefined} />)}
              </div>
            </div>
            <span class="entry-caption">历史原型照片</span>
          </a>
        </div>
      </section>
      <section class="lane section-shell" id="carry" data-lane="carry" aria-labelledby="carry-title">
        <div class="lane-rail" data-reveal aria-hidden="true"></div>
        <div class="section-heading reveal">
          <h2 id="carry-title">Yi盘</h2>
        </div>
        <article class="project-featured reveal">
          <div class="project-main">
            <p class="project-summary">{yipan.summary}</p>
            <div class="tags">{yipan.tags.map((tag) => <span>{tag}</span>)}</div>
            <div class="project-links">
              <a class="button primary" href={yipan.href} target="_blank" rel="noreferrer">查看公开仓库 <span>↗</span></a>
              <span class="status active"><i></i>{yipan.status}</span>
            </div>
            {yipan.caveat && <p class="caveat">当前限制 · {yipan.caveat}</p>}
          </div>
          <figure class="yipan-flow" data-loop>
            <figcaption>
              <span class="flow-label">结构示意 · 非产品截图</span>
              <span class="visually-hidden">盘内资料与任务供 Yi盘工作台检索；需要智能处理时，工作台按需请求云端模型并取回结果；产出与任务记录留在盘内，经记录与沉淀后成为下一次继续工作的资料。云端模型负责推理，长期资料不离开 U 盘。</span>
            </figcaption>
            <div class="flow" aria-hidden="true">
              <div class="flow-drive">
                <span class="flow-drive-tag">U 盘内</span>
                <span class="flow-rail"><b>记录 · 沉淀</b></span>
                <div class="flow-node n1"><b>盘内资料与任务</b><small>Inbox 确认后写入长期知识</small></div>
                <div class="flow-step s1"><i></i><span>检索 / 继续</span></div>
                <div class="flow-node n2"><b>Yi盘工作台</b><small>受管 Agent 处理当前任务</small></div>
                <div class="flow-step s2"><i></i><span>生成 / 记录</span></div>
                <div class="flow-node n3"><b>产出与任务记录</b><small>留在盘内，随盘带走</small></div>
              </div>
              <div class="flow-link"><span class="out"><i></i>按需请求</span><span class="back"><i></i>返回结果</span></div>
              <div class="flow-cloud"><b>云端模型</b><small>按需推理</small></div>
            </div>
          </figure>
        </article>
      </section>

      <section class="lane section-shell" id="see" data-lane="see" aria-labelledby="see-title">
        <div class="lane-rail" data-reveal aria-hidden="true"></div>
        <div class="section-heading reveal">
          <h2 id="see-title">DSH Usage 与开发工具</h2>
        </div>
        <article class="spotlight reveal">
          <div>
            <p class="project-summary">{dshUsage.summary}</p>
            <div class="tags">{dshUsage.tags.map((tag) => <span>{tag}</span>)}</div>
            <dl class="metric-strip">
              <div><dt>近 30 天下载</dt>{dshDownloads !== null ? <dd data-count={dshDownloads}>{numberFormat.format(dshDownloads)}</dd> : <dd class="is-unknown">暂不可用</dd>}</div>
              <div><dt>npm 最新版本</dt>{dshNpm.latest ? <dd>{dshNpm.latest}</dd> : <dd class="is-unknown">暂不可用</dd>}</div>
              <div><dt>已发布版本</dt>{typeof dshNpm.versionCount === "number" ? <dd data-count={dshNpm.versionCount}>{numberFormat.format(dshNpm.versionCount)}</dd> : <dd class="is-unknown">暂不可用</dd>}</div>
            </dl>
            <div class="project-links">
              <a class="button lane-primary" href={dshUsage.href} target="_blank" rel="noreferrer">查看仓库 <span>↗</span></a>
              {dshNpm.url && <a class="button secondary" href={dshNpm.url} target="_blank" rel="noreferrer">npm <span>↗</span></a>}
              {dshSignal && <a class={`signal-chip ${dshSignal.tone}`} href={dshSignal.href} target="_blank" rel="noreferrer"><i></i>{dshSignal.label} ↗</a>}
            </div>
            <p class="caveat">{dshUsage.caveat}</p>
          </div>
          <div class="app-stack">
            <figure class="app-window" data-reveal data-loop data-shots aria-label="DSH Usage 运行截图">
              <div class="app-chrome">
                <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><span aria-hidden="true">DSH WEB · 用量</span>
                <div class="shot-tabs" role="group" aria-label="切换截图">
                  {dshSlides.map((slide, index) => <button type="button" data-shot={slide.key} aria-pressed={index === 0 ? "true" : "false"}>{slide.label}</button>)}
                </div>
                <button class="shot-rotate" type="button" data-shot-rotate aria-pressed="false" title="暂停截图轮换"><span class="visually-hidden">暂停截图轮换</span><svg viewBox="0 0 16 16" aria-hidden="true"><path class="icon-pause" d="M5 3.5v9M11 3.5v9" /><path class="icon-play" d="M5.5 3.5v9l7-4.5z" /></svg></button>
              </div>
              <div class="app-shot">
                {dshSlides.map((slide, index) => (
                  <div class="shot-slide" data-slide={slide.key} aria-hidden={index === 0 ? undefined : "true"}>
                    <Image src={slide.src} alt={slide.alt} widths={[640, 960, 1400]} sizes="(max-width: 1200px) 92vw, 700px" loading="lazy" />
                  </div>
                ))}
              </div>
              <figcaption>真实运行界面，夹具数据；项目名为占位。</figcaption>
            </figure>
          </div>
        </article>
        <div class="tool-groups" data-loop>
          {toolGroups.map((group) => (
            <div class="tool-group reveal">
              <div class="tool-group-head"><h3>{group.label}</h3></div>
              <ul class="tool-list">
                {group.tools.map((tool, index) => {
                  const signal = primarySignal(tool.slug);
                  const shot = toolShot(tool.slug);
                  return (
                    <li class={`tool-row reveal${shot ? " has-shot" : ""}`} style={`--rd:${index * 0.06}s`}>
                      <div class="tool-copy">
                        <h4><a href={tool.href} target="_blank" rel="noreferrer">{tool.name}</a>{isRecent(tool.slug) && <><i class="recent-dot" aria-hidden="true"></i><span class="visually-hidden">（近 30 天有更新）</span></>}</h4>
                        <p>{tool.summary}</p>
                        <div class="tool-meta">
                          <div class="tags">{tool.tags.map((tag) => <span>{tag}</span>)}</div>
                          {signal && <span class={`signal-chip ${signal.tone}`}><i></i>{signal.label}</span>}
                        </div>
                        {tool.caveat && <small class="caveat">{tool.caveat}</small>}
                      </div>
                      {shot && (
                        <figure class="tool-shot">
                          <span class="tool-shot-frame"><Image src={shot.src} alt={shot.alt} widths={[160, 320, 640]} sizes="(max-width: 760px) calc(100vw - 62px), 160px" loading="lazy" class={shot.fit === "contain" ? "is-contain" : undefined} style={shot.position ? `object-position:${shot.position}` : undefined} /></span>
                          <figcaption>{shot.label}</figcaption>
                        </figure>
                      )}
                      <span class="tool-arrow" aria-hidden="true">↗</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="lane section-shell" id="touch" data-lane="touch" aria-labelledby="touch-title">
        <div class="lane-rail" data-reveal aria-hidden="true"></div>
        <div class="section-heading reveal">
          <h2 id="touch-title">Hardware Lab</h2>
        </div>
        <div class="pcb-strip" data-reveal data-loop aria-hidden="true">
          <svg viewBox="0 0 1200 120" preserveAspectRatio="xMidYMid slice">
            <path class="pcb-trace" pathLength="100" style="--td:0s" d="M40 34H300L330 50H520" /><path class="pcb-trace" pathLength="100" style="--td:.08s" d="M40 60H520" /><path class="pcb-trace" pathLength="100" style="--td:.16s" d="M40 86H300L330 70H520" />
            <path class="pcb-trace" pathLength="100" style="--td:.3s" d="M680 50H870L900 34H1150" /><path class="pcb-trace" pathLength="100" style="--td:.38s" d="M680 60H1150" /><path class="pcb-trace" pathLength="100" style="--td:.46s" d="M680 70H870L900 86H1150" />
            <path class="pcb-pulse" pathLength="100" style="--pd:0s" d="M40 34H300L330 50H520" /><path class="pcb-pulse" pathLength="100" style="--pd:-.6s" d="M40 60H520" /><path class="pcb-pulse" pathLength="100" style="--pd:-1.2s" d="M40 86H300L330 70H520" />
            <path class="pcb-pulse" pathLength="100" style="--pd:-1.7s" d="M680 50H870L900 34H1150" /><path class="pcb-pulse" pathLength="100" style="--pd:-2.3s" d="M680 60H1150" /><path class="pcb-pulse" pathLength="100" style="--pd:-2.9s" d="M680 70H870L900 86H1150" />
            <circle class="pcb-pad" cx="34" cy="34" r="6" /><circle class="pcb-pad" cx="34" cy="60" r="6" /><circle class="pcb-pad" cx="34" cy="86" r="6" />
            <circle class="pcb-via" cx="300" cy="34" r="3.5" /><circle class="pcb-via" cx="300" cy="86" r="3.5" /><circle class="pcb-via" cx="900" cy="34" r="3.5" /><circle class="pcb-via" cx="900" cy="86" r="3.5" />
            <rect class="pcb-chip" x="186" y="52" width="40" height="16" rx="2" /><rect class="pcb-chip" x="974" y="52" width="40" height="16" rx="2" />
            <path class="pcb-legs" d="M540 22v-8M560 22v-8M580 22v-8M600 22v-8M620 22v-8M640 22v-8M660 22v-8M540 98v8M560 98v8M580 98v8M600 98v8M620 98v8M640 98v8M660 98v8" />
            <rect class="pcb-chip" x="520" y="22" width="160" height="76" rx="6" />
            <text class="pcb-label" x="600" y="58">HW LAB</text><text class="pcb-sub" x="600" y="76">{hardwareOk ? `${hardwareProjects.length} PROTOTYPES` : "PROTOTYPES"}</text>
            <circle class="pcb-led" style="--pd:-1.7s" cx="1160" cy="34" r="6" /><circle class="pcb-led" style="--pd:-2.3s" cx="1160" cy="60" r="6" /><circle class="pcb-led" style="--pd:-2.9s" cx="1160" cy="86" r="6" />
          </svg>
          <span class="pcb-silk">RONGYI · HARDWARE LAB · REV {studio.hardware.statusDate ? studio.hardware.statusDate.replaceAll("-", ".") : "—"}</span>
        </div>
        {hardwareOk ? (
          <>
            <div class="hw-filters" data-hw-filters role="group" aria-label="按芯片筛选硬件项目">
              {hardwareFilters.map((filter, index) => (
                <button type="button" data-filter={filter.key} aria-pressed={index === 0 ? "true" : "false"}>{filter.label} <b>{filter.count}</b></button>
              ))}
              <span class="hw-filter-status" data-hw-status aria-live="polite">显示 {hardwareProjects.length} / {hardwareProjects.length} 个项目</span>
            </div>
            <ul class="hw-grid" id="hw-grid">
              {hardwareProjects.map((project, index) => {
                const photo = hardwarePhoto(project.slug);
                const wide = hardwareFeatured.includes(project.slug);
                return (
                <li class={`hw-item reveal${wide ? " is-wide" : ""}`} data-family={project.family} style={`--rd:${(index % 5) * 0.05}s`}>
                  <div class={`hw-card${photo ? " has-photo" : ""}`}>
                    <div class="hw-media">
                      {photo ? (
                        <Image src={photo.src} alt="" widths={[208, 320, 560, 1120]} sizes={wide ? "(max-width: 540px) 104px, 560px" : "(max-width: 540px) 104px, 280px"} loading="lazy" style={photo.position ? `object-position:${photo.position}` : undefined} />
                      ) : (
                        <span class="hw-media-empty" aria-hidden="true"></span>
                      )}
                      <span class="hw-media-tag">{photo ? <><span>历史照片</span><span>{photoDate(photo.date)}</span></> : "未公开实物照片"}</span>
                    </div>
                    <div class="hw-body">
                      <div class="hw-top"><span class="hw-chip">{project.chip}</span><i class="hw-led" aria-hidden="true"></i></div>
                      <h3><a href={project.repo} target="_blank" rel="noreferrer">{hardwareShortNames[project.slug] ?? project.name}</a></h3>
                      <p>{project.summary}</p>
                      <a class={`hw-evidence ${hardwareEvidenceTone(project.evidence?.status)}`} href={project.evidence?.runUrl ?? project.repo} target="_blank" rel="noreferrer" aria-label={`${project.name}：${hardwareEvidenceLabel[project.evidence?.status] ?? hardwareEvidenceLabel.unknown}`}><i aria-hidden="true"></i>{hardwareEvidenceLabel[project.evidence?.status] ?? hardwareEvidenceLabel.unknown} ↗</a>
                      <span class="hw-stack" title={project.platform}><span class="visually-hidden">{familyLabel(project.family)} · </span>{stackLine(project.platform)}</span>
                    </div>
                  </div>
                </li>
                );
              })}
            </ul>
            <button class="hw-more" type="button" data-hw-more aria-controls="hw-grid" hidden>展开全部</button>
            <p class="hw-note reveal">
              <a href={studio.hardware.indexUrl} target="_blank" rel="noreferrer">项目索引 ↗</a> · 当前提交核验 {verifiedHardware} / {hardwareProjects.length}{hardwareSignal && <> · <a href={hardwareSignal.href} target="_blank" rel="noreferrer">{hardwareSignal.label}</a></>}。接线与供电要求见各项目 README。
            </p>
          </>
        ) : (
          <p class="hw-empty">这次构建暂时无法读取 Hardware Lab 索引，不用旧数据填充。<a href={studio.hardware.indexUrl} target="_blank" rel="noreferrer">直接查看索引 ↗</a></p>
        )}
      </section>

      <section class="proof section-shell" id="proof" data-lane="carry" aria-labelledby="proof-title">
        <div class="proof-copy reveal">
          <h2 id="proof-title">发布与构建</h2>
          <p>GitHub / npm，每 6 小时刷新。</p>
          <p class="snapshot-warning" data-snapshot-at={oldestSnapshot} hidden={!snapshotDelayed} role="status">数据采集已超过 12 小时，刷新可能延迟。以下为注明时间的快照，当前状态请打开源链接核对。</p>
          <details class="status-method">
            <summary>检查方法</summary>
            <p>CI 核对指定工作流与当前默认分支 HEAD；失败、未验证和未知状态直接标出。构建产物附下载期限。</p>
            <a class="text-link" href={statusSourceUrl} target="_blank" rel="noopener noreferrer">查看采集脚本 ↗</a>
          </details>
        </div>
        <div class="signal-panel reveal">
          <div class="signal-header"><span>GITHUB 状态快照</span><small>截至 {refreshedAt} CST</small></div>
          {proofGroups.map((group) => (
            <div class="signal-lane" data-lane={group.lane}>
              <div class="signal-group"><i aria-hidden="true"></i>{laneMeta[group.lane].short}</div>
              {group.items.flatMap((item) => proofRows(item)).map((row) => {
                const isArtifact = row.kind === "artifact";
                const status = repoStatus[row.slug];
                return (
                  <a class={`signal-row ${row.tone}`} href={row.href} target="_blank" rel="noopener noreferrer" data-artifact-status={isArtifact ? status?.artifact.status : undefined} data-artifact-expires-at={isArtifact ? status?.artifact.artifacts?.find((item) => !item.expired && Date.parse(item.expiresAt) > Date.now())?.expiresAt : undefined}>
                    <i class={iconClass(row.tone)}></i><b>{row.name}</b><span data-signal-label>{row.label}</span><em>↗</em>
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      </section>
      <section class="lane section-shell" id="log" aria-labelledby="log-title">
        <div class="lane-rail" data-reveal aria-hidden="true"></div>
        <div class="section-heading reveal">
          <h2 id="log-title">最近更新</h2>
        </div>
        <ol class="timeline" data-reveal>
          {updates.map((item, index) => (
            <li class="tl-item reveal" data-lane={item.lane} style={`--rd:${index * 0.05}s`}>
              <a href={item.href} target="_blank" rel="noreferrer">
                <time datetime={isoDay(item.date)}>{formatDay(item.date)}</time>
                <i class="tl-dot" aria-hidden="true"></i>
                <div class="tl-body">
                  <div class="tl-tags"><span>{item.type}</span><em>{laneMeta[item.lane].word}</em></div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
                <span class="tl-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="feed-note">更新流生成于 {studioRefreshedAt} CST{degradedSources.length > 0 && <>；<b>{degradedSources.join("、")}暂时无法确认</b>，本次没有用旧数据补齐</>}。</p>
      </section>

    </main>

    <footer>
      <div><b>RONGYI</b><span>独立开发者 · Yi盘创始人</span></div>
      <p><a href="https://github.com/rongyishuaige7" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://github.com/rongyishuaige7/yipan-showcase/issues" target="_blank" rel="noreferrer">Yi盘反馈 ↗</a></p>
      <span>© {new Date().getFullYear()} @rongyishuaige7</span>
    </footer>

    <script>
      import { initStatusFreshness } from "../scripts/status-freshness";
      import { initMotion } from "../scripts/motion";
      import { initTheme } from "../scripts/theme";
      import { initParticleField } from "../scripts/particle-field";
      import { initSectionState } from "../scripts/section-state";
      initStatusFreshness();
      const disposeSections = initSectionState();
      initMotion();
      initTheme();
      const disposeParticles = initParticleField();
      if (import.meta.hot) import.meta.hot.dispose(() => { disposeParticles?.(); disposeSections?.(); });
    </script>
  </body>
</html>
